version: 4
data:
  graphs:
    yoke-spec-creation:
      metadata:
        id: yoke-spec-creation
        name: spec-creation
      nodes:
        '[yoke-helper-approve-array]:array "Approve Questions"':
          data:
            flatten: true
            flattenDeep: false
          outgoingConnections:
            - output->"approve" yoke-step-approve/questions
          visualData: 3650/700/200/null//
        '[yoke-helper-approve-prompt]:text "Approve Prompt"':
          data:
            normalizeLineEndings: true
            text: |-
              Approve this hardened spec? (yes/no)

              {{spec}}
          outgoingConnections:
            - output->"Approve Questions" yoke-helper-approve-array/input1
          visualData: 3300/600/300/null//
        '[yoke-helper-assemble]:code "assemble"':
          data:
            allowConsole: false
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              function parseJson(s) {
                try {
                  return JSON.parse(
                    String(s ?? '').replace(/^```(?:json)?\s*/m, '').replace(/\s*```\s*$/m, '').trim()
                  );
                } catch (e) { console.error("assemble: JSON parse failed:", e); return null; }
              }

              function parseListUnderHeading(text, headingPat) {
                const lines = text.split('\n');
                let inSection = false;
                const items = [];
                for (const line of lines) {
                  const hm = line.match(/^#{1,3}\s+(.+)$/);
                  if (hm) { inSection = headingPat.test(hm[1].trim()); continue; }
                  if (inSection) {
                    const m = line.match(/^(?:\d+[.)\s]|[-*]\s)(.+)/);
                    if (m) items.push(m[1].trim());
                  }
                }
                return items;
              }

              const intakeText = String(inputs.intake?.value ?? '');

              const enrichText = String(inputs.enrich?.value ?? '');

              const criticText = String(inputs.critic?.value ?? '');

              const securityText = String(inputs.security?.value ?? '');

              const titleMatch = intakeText.match(/^#{1,2}\s+(.+)$/m);

              const title = titleMatch
                ? titleMatch[1].trim()
                : (intakeText.split('\n').find(l => l.trim()) ?? 'Untitled').slice(0, 120);
              const requirements = parseListUnderHeading(intakeText,
              /^requirements$/i);

              const acceptanceCriteria = parseListUnderHeading(intakeText,
              /^acceptance criteria$/i);

              const criticData = parseJson(criticText);

              const secData = parseJson(securityText);

              const description = enrichText ? intakeText + '\n\n' + enrichText
              : intakeText;

              const spec = {
                title,
                description,
                requirements,
                acceptanceCriteria,
                weaknesses: criticData?.weaknesses ?? [],
                securityFindings: secData?.securityFindings ?? secData?.findings ?? []
              };

              return { spec: { type: 'string', value: JSON.stringify(spec) } };
            inputNames:
              - intake
              - enrich
              - critic
              - security
            outputNames:
              - spec
          outgoingConnections:
            - spec->"Approve Prompt" yoke-helper-approve-prompt/spec
            - spec->"Ticket Args" yoke-helper-ct-array/input1
            - spec->"spec output" yoke-helper-out-spec/value
          visualData: 2800/700/300/null//
        '[yoke-helper-critic-args]:array "critic Args"':
          data:
            flatten: true
            flattenDeep: false
          outgoingConnections:
            - output->"critic" yoke-step-critic/arguments
          visualData: 1750/700/200/null//
        '[yoke-helper-critic-modelid]:text "critic Model"':
          data:
            normalizeLineEndings: true
            text: opus
          outgoingConnections:
            - output->"critic Args" yoke-helper-critic-args/input2
          visualData: 1400/820/300/null//
        '[yoke-helper-critic-prompt]:text "critic Prompt"':
          data:
            normalizeLineEndings: true
            text: |-
              You are an adversarial critic. Review this spec for weaknesses — gaps, ambiguities, missing edge cases. Respond with STRICT JSON only, no markdown fences: {"weaknesses":[{"text":"...","severity":"low|medium|high","blocking":false}]}

              Spec to review:
              {{spec}}
          outgoingConnections:
            - output->"critic Args" yoke-helper-critic-args/input1
          visualData: 1400/580/300/null//
        '[yoke-helper-ct-array]:array "Ticket Args"':
          data:
            flatten: true
            flattenDeep: false
          outgoingConnections:
            - output->"If Approved" yoke-helper-gate-if/value
          visualData: 4750/550/200/null//
        '[yoke-helper-enrich-args]:array "enrich Args"':
          data:
            flatten: true
            flattenDeep: false
          outgoingConnections:
            - output->"enrich" yoke-step-enrich/arguments
          visualData: 1750/200/200/null//
        '[yoke-helper-enrich-modelid]:text "enrich Model"':
          data:
            normalizeLineEndings: true
            text: sonnet
          outgoingConnections:
            - output->"enrich Args" yoke-helper-enrich-args/input2
          visualData: 1400/320/300/null//
        '[yoke-helper-enrich-prompt]:text "enrich Prompt"':
          data:
            normalizeLineEndings: true
            text: >-
              You are a product analyst reviewing a spec draft. Return ONLY
              additional edge cases, non-functional requirements, and
              clarifications that are missing from the draft. Output a single
              markdown section titled exactly '## Enrichment additions' followed
              by bullet points. Do NOT rewrite, repeat, or summarize the
              original draft.


              Spec draft:

              {{spec}}
          outgoingConnections:
            - output->"enrich Args" yoke-helper-enrich-args/input1
          visualData: 1400/80/300/null//
        '[yoke-helper-gate-if]:if "If Approved"':
          data:
            unconnectedControlFlowExcluded: true
          outgoingConnections:
            - output->"create-ticket" yoke-step-create-ticket/arguments
          visualData: 4750/700/125/null//
        '[yoke-helper-gate]:code "Gate"':
          data:
            allowConsole: false
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              const answers = inputs.answer?.value;

              const first = (Array.isArray(answers) ? (answers[0] ?? '') :
              String(answers ?? '')).trim().toLowerCase();

              return { approved: { type: 'boolean', value: first.startsWith('y')
              } };
            inputNames:
              - answer
            outputNames:
              - approved
          outgoingConnections:
            - approved->"If Approved" yoke-helper-gate-if/if
            - approved->"approved output" yoke-helper-out-approved/value
          visualData: 4400/700/300/null//
        '[yoke-helper-graph-input]:graphInput "Request Input"':
          data:
            dataType: string
            id: request
            useDefaultValueInput: false
          outgoingConnections:
            - data->"intake Prompt" yoke-helper-intake-prompt/request
          visualData: 0/400/300/null//
        '[yoke-helper-intake-args]:array "intake Args"':
          data:
            flatten: true
            flattenDeep: false
          outgoingConnections:
            - output->"intake" yoke-step-intake/arguments
          visualData: 700/400/200/null//
        '[yoke-helper-intake-modelid]:text "intake Model"':
          data:
            normalizeLineEndings: true
            text: sonnet
          outgoingConnections:
            - output->"intake Args" yoke-helper-intake-args/input2
          visualData: 350/520/300/null//
        '[yoke-helper-intake-prompt]:text "intake Prompt"':
          data:
            normalizeLineEndings: true
            text: >-
              You are a product analyst. Produce a concise spec draft for:
              {{request}}


              Use exactly this structure (do not add or rename sections):


              # <Title>


              <one-paragraph description>


              ## Requirements

              - <requirement 1>

              - <requirement 2>

              ...


              ## Acceptance Criteria

              - <criterion 1>

              - <criterion 2>

              ...
          outgoingConnections:
            - output->"intake Args" yoke-helper-intake-args/input1
          visualData: 350/280/300/null//
        '[yoke-helper-join]:code "join"':
          data:
            allowConsole: false
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: |-
              const draftText = String(inputs.draft?.value ?? '');
              const additionsText = String(inputs.additions?.value ?? '');
              const combined = additionsText
                ? draftText + '\n\n' + additionsText
                : draftText;
              return { spec: { type: 'string', value: combined } };
            inputNames:
              - draft
              - additions
            outputNames:
              - spec
          outgoingConnections:
            - spec->"critic Prompt" yoke-helper-critic-prompt/spec
            - spec->"security Prompt" yoke-helper-security-prompt/spec
          visualData: 2450/700/300/null//
        '[yoke-helper-out-approved]:graphOutput "approved output"':
          data:
            dataType: boolean
            id: approved
          visualData: 5600/700/300/null//
        '[yoke-helper-out-spec]:graphOutput "spec output"':
          data:
            dataType: string
            id: spec
          visualData: 5600/400/300/null//
        '[yoke-helper-out-ticket]:graphOutput "ticketId output"':
          data:
            dataType: number
            id: ticketId
          visualData: 5600/1000/300/null//
        '[yoke-helper-security-args]:array "security Args"':
          data:
            flatten: true
            flattenDeep: false
          outgoingConnections:
            - output->"security" yoke-step-security/arguments
          visualData: 1750/1200/200/null//
        '[yoke-helper-security-modelid]:text "security Model"':
          data:
            normalizeLineEndings: true
            text: opus
          outgoingConnections:
            - output->"security Args" yoke-helper-security-args/input2
          visualData: 1400/1320/300/null//
        '[yoke-helper-security-prompt]:text "security Prompt"':
          data:
            normalizeLineEndings: true
            text: |-
              You are a security analyst. Review this spec for security risks. Respond with STRICT JSON only, no markdown fences: {"securityFindings":[{"text":"...","severity":"low|medium|high|critical","blocking":false}]}

              Spec to review:
              {{spec}}
          outgoingConnections:
            - output->"security Args" yoke-helper-security-args/input1
          visualData: 1400/1080/300/null//
        '[yoke-step-approve]:userInput "approve"':
          data:
            prompt: This is an example question?
            useInput: true
          outgoingConnections:
            - output->"Gate" yoke-helper-gate/answer
          visualData: 4000/700/250/null//
        '[yoke-step-create-ticket]:externalCall "create-ticket"':
          data:
            functionName: persistTicket
            useErrorOutput: false
            useFunctionNameInput: false
          outgoingConnections:
            - result->"ticketId output" yoke-helper-out-ticket/value
          visualData: 5100/700/150/null//
        '[yoke-step-critic]:externalCall "critic"':
          data:
            functionName: runClaudeCli
            useErrorOutput: false
            useFunctionNameInput: false
          outgoingConnections:
            - result->"assemble" yoke-helper-assemble/critic
          visualData: 2100/700/150/null//
        '[yoke-step-enrich]:externalCall "enrich"':
          data:
            functionName: runClaudeCli
            useErrorOutput: false
            useFunctionNameInput: false
          outgoingConnections:
            - result->"assemble" yoke-helper-assemble/enrich
            - result->"join" yoke-helper-join/additions
          visualData: 2100/200/150/null//
        '[yoke-step-intake]:externalCall "intake"':
          data:
            functionName: runClaudeCli
            useErrorOutput: false
            useFunctionNameInput: false
          outgoingConnections:
            - result->"assemble" yoke-helper-assemble/intake
            - result->"enrich Prompt" yoke-helper-enrich-prompt/spec
            - result->"join" yoke-helper-join/draft
          visualData: 1050/400/150/null//
        '[yoke-step-security]:externalCall "security"':
          data:
            functionName: runClaudeCli
            useErrorOutput: false
            useFunctionNameInput: false
          outgoingConnections:
            - result->"assemble" yoke-helper-assemble/security
          visualData: 2100/1200/150/null//
  metadata:
    description: "6-step spec-creation workflow: intake → enrich → critic → security
      → approve → create-ticket"
    id: yoke-spec-creation-project
    mainGraphId: yoke-spec-creation
    title: Yoke Spec Creation
  plugins: []
  references: []
