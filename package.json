{
  "name": "yoke",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rivet:e1": "tsx src/rivet/e1.ts",
    "rivet:host": "tsx src/rivet/main.ts",
    "rivet:build-project": "tsx src/rivet/project/write-cli.ts",
    "doctor": "tsx src/rivet/doctor.ts",
    "bootstrap": "./bootstrap.sh"
  },
  "dependencies": {
    "@ironclad/rivet-node": "1.25.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.32",
    "drizzle-kit": "^0.31.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.69.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
